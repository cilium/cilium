#! --lb-test-fault-probability=0.0 --enable-scale-to-zero

# Start the test application
hive start

# Add service w/o "service.cilium.io/scale-to-zero"
k8s/add service.yaml endpointslice.yaml
db/cmp frontends frontends.table

# Check maps
lb/maps-dump maps.actual
* cmp maps.actual maps.expected

# Nothing is held while nothing opted in
lb/scale-to-zero-dump scale-to-zero.actual
* cmp scale-to-zero.actual scale-to-zero_empty.expected

# Opt into scale-to-zero. Every frontend of the service is then tracked by the
# identifier it has in the services map.
sed 'placeholder: placeholder' 'service.cilium.io/scale-to-zero: "true"' service.yaml
k8s/update service.yaml
lb/scale-to-zero-dump scale-to-zero.actual
* cmp scale-to-zero.actual scale-to-zero.expected

# Opting in changes nothing else in the datapath
lb/maps-dump maps.actual
* cmp maps.actual maps.expected

# A value other than "true" does not opt in
sed 'scale-to-zero: "true"' 'scale-to-zero: "yes"' service.yaml
k8s/update service.yaml
lb/scale-to-zero-dump scale-to-zero.actual
* cmp scale-to-zero.actual scale-to-zero_empty.expected

# Opt in again
sed 'scale-to-zero: "yes"' 'scale-to-zero: "true"' service.yaml
k8s/update service.yaml
lb/scale-to-zero-dump scale-to-zero.actual
* cmp scale-to-zero.actual scale-to-zero.expected

# Removing the annotation releases the service
sed 'service.cilium.io/scale-to-zero: "true"' 'placeholder: placeholder' service.yaml
k8s/update service.yaml
lb/scale-to-zero-dump scale-to-zero.actual
* cmp scale-to-zero.actual scale-to-zero_empty.expected

# Opt in once more, so that the service is held when it is deleted
sed 'placeholder: placeholder' 'service.cilium.io/scale-to-zero: "true"' service.yaml
k8s/update service.yaml
lb/scale-to-zero-dump scale-to-zero.actual
* cmp scale-to-zero.actual scale-to-zero.expected

# Delete the service
k8s/delete service.yaml

# Deleting a service releases what it held
* lb/maps-empty
lb/scale-to-zero-dump scale-to-zero.actual
* cmp scale-to-zero.actual scale-to-zero_empty.expected

#####

-- frontends.table --
Address               Type         ServiceName   PortName   Status  Backends
0.0.0.0:30781/TCP     NodePort     test/echo     http       Done    10.244.1.1:80/TCP
10.96.50.104:80/TCP   ClusterIP    test/echo     http       Done    10.244.1.1:80/TCP
172.16.1.1:80/TCP     LoadBalancer test/echo     http       Done    10.244.1.1:80/TCP

-- service.yaml --
apiVersion: v1
kind: Service
metadata:
  name: echo
  namespace: test
  annotations:
    placeholder: placeholder
spec:
  clusterIP: 10.96.50.104
  clusterIPs:
  - 10.96.50.104
  ports:
  - name: http
    nodePort: 30781
    port: 80
    protocol: TCP
    targetPort: 80
  selector:
    name: echo
  sessionAffinity: None
  type: LoadBalancer
status:
  loadBalancer:
    ingress:
    - ip: 172.16.1.1

-- endpointslice.yaml --
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  labels:
    kubernetes.io/service-name: echo
  name: echo-kvlm2
  namespace: test
addressType: IPv4
endpoints:
- addresses:
  - 10.244.1.1
  nodeName: nodeport-worker
ports:
- name: http
  port: 80
  protocol: TCP

-- maps.expected --
BE: ID=1 ADDR=10.244.1.1:80/TCP STATE=active
REV: ID=1 ADDR=0.0.0.0:30781
REV: ID=2 ADDR=10.96.50.104:80
REV: ID=3 ADDR=172.16.1.1:80
SVC: ID=0 ADDR=10.96.50.104:0/ANY SLOT=0 LBALG=undef AFFTimeout=0 COUNT=0 QCOUNT=0 FLAGS=ClusterIP+non-routable
SVC: ID=0 ADDR=172.16.1.1:0/ANY SLOT=0 LBALG=undef AFFTimeout=0 COUNT=0 QCOUNT=0 FLAGS=LoadBalancer+non-routable
SVC: ID=1 ADDR=0.0.0.0:30781/TCP SLOT=0 LBALG=undef AFFTimeout=0 COUNT=1 QCOUNT=0 FLAGS=NodePort+non-routable
SVC: ID=1 ADDR=0.0.0.0:30781/TCP SLOT=1 BEID=1 COUNT=0 QCOUNT=0 FLAGS=NodePort+non-routable
SVC: ID=2 ADDR=10.96.50.104:80/TCP SLOT=0 LBALG=undef AFFTimeout=0 COUNT=1 QCOUNT=0 FLAGS=ClusterIP+non-routable
SVC: ID=2 ADDR=10.96.50.104:80/TCP SLOT=1 BEID=1 COUNT=0 QCOUNT=0 FLAGS=ClusterIP+non-routable
SVC: ID=3 ADDR=172.16.1.1:80/TCP SLOT=0 LBALG=undef AFFTimeout=0 COUNT=1 QCOUNT=0 FLAGS=LoadBalancer
SVC: ID=3 ADDR=172.16.1.1:80/TCP SLOT=1 BEID=1 COUNT=0 QCOUNT=0 FLAGS=LoadBalancer
-- scale-to-zero.expected --
SCALETOZERO: ID=1
SCALETOZERO: ID=2
SCALETOZERO: ID=3
-- scale-to-zero_empty.expected --
