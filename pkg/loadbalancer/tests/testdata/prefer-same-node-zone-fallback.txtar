#! --enable-service-topology --lb-test-fault-probability=0.0
#
# Test the PreferSameNode fallback chain as specified in KEP-3015:
# same-node backends are preferred, then backends whose ForZones hints include
# the local zone, and finally all backends.
#

# Set the node zone label before starting so it's read by the zone watcher.
test/set-node-labels topology.kubernetes.io/zone=foo

# Start and wait for watchers
hive start

# Add the service with trafficDistribution=PreferSameNode and three endpoints:
# 10.244.1.1 on the local node ('testnode') in zone foo,
# 10.244.2.1 on another node in zone foo,
# 10.244.3.1 on another node in zone bar.
k8s/add service.yaml
db/cmp services services.table
k8s/add local.yaml same-zone.yaml other-zone.yaml
db/cmp backends backends.table

# Only the local-node backend should be selected.
db/cmp frontends frontends-local.table

# Remove the local-node endpoint. We fall back to the backend whose
# ForZones hint includes the local zone.
k8s/delete local.yaml
db/cmp frontends frontends-same-zone.table

# Move the node to a zone which no ForZones hint includes. We fall back
# to all backends.
test/set-node-labels topology.kubernetes.io/zone=baz
db/cmp frontends frontends-all.table

# Move the node back. The same-zone backend is selected again.
test/set-node-labels topology.kubernetes.io/zone=foo
db/cmp frontends frontends-same-zone.table

# Remove the hints from one of the endpoints. Since not all endpoints
# have ForZones hints, we fall back to all backends.
k8s/update other-zone-no-hints.yaml
db/cmp frontends frontends-all.table

# Restore the hints and the local-node endpoint.
k8s/update other-zone.yaml
db/cmp frontends frontends-same-zone.table
k8s/add local.yaml
db/cmp frontends frontends-local.table

#####

-- services.table --
Name        Source   PortNames  TrafficPolicy  Flags
test/echo   k8s      http=80    Cluster        TrafficDistribution=PreferSameNode

-- backends.table --
Service    Address
test/echo  10.244.1.1:80/TCP
test/echo  10.244.2.1:80/TCP
test/echo  10.244.3.1:80/TCP

-- frontends-local.table --
Address               Type        ServiceName   PortName   Status  Backends
10.96.50.104:80/TCP   ClusterIP   test/echo     http       Done    10.244.1.1:80/TCP

-- frontends-same-zone.table --
Address               Type        ServiceName   PortName   Status  Backends
10.96.50.104:80/TCP   ClusterIP   test/echo     http       Done    10.244.2.1:80/TCP

-- frontends-all.table --
Address               Type        ServiceName   PortName   Status  Backends
10.96.50.104:80/TCP   ClusterIP   test/echo     http       Done    10.244.2.1:80/TCP, 10.244.3.1:80/TCP

-- service.yaml --
apiVersion: v1
kind: Service
metadata:
  name: echo
  namespace: test
spec:
  clusterIP: 10.96.50.104
  clusterIPs:
  - 10.96.50.104
  ports:
  - name: http
    port: 80
    protocol: TCP
    targetPort: 80
  selector:
    name: echo
  type: ClusterIP
  trafficDistribution: PreferSameNode

-- local.yaml --
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  labels:
    kubernetes.io/service-name: echo
  name: echo-local
  namespace: test
addressType: IPv4
endpoints:
- addresses:
  - 10.244.1.1
  conditions:
    ready: true
    serving: true
    terminating: false
  nodeName: testnode
  zone: foo
  hints:
    forNodes:
    - name: testnode
    forZones:
    - name: foo
ports:
- name: http
  port: 80
  protocol: TCP

-- same-zone.yaml --
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  labels:
    kubernetes.io/service-name: echo
  name: echo-same-zone
  namespace: test
addressType: IPv4
endpoints:
- addresses:
  - 10.244.2.1
  conditions:
    ready: true
    serving: true
    terminating: false
  nodeName: node-b
  zone: foo
  hints:
    forNodes:
    - name: node-b
    forZones:
    - name: foo
ports:
- name: http
  port: 80
  protocol: TCP

-- other-zone.yaml --
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  labels:
    kubernetes.io/service-name: echo
  name: echo-other-zone
  namespace: test
addressType: IPv4
endpoints:
- addresses:
  - 10.244.3.1
  conditions:
    ready: true
    serving: true
    terminating: false
  nodeName: node-c
  zone: bar
  hints:
    forNodes:
    - name: node-c
    forZones:
    - name: bar
ports:
- name: http
  port: 80
  protocol: TCP

-- other-zone-no-hints.yaml --
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  labels:
    kubernetes.io/service-name: echo
  name: echo-other-zone
  namespace: test
addressType: IPv4
endpoints:
- addresses:
  - 10.244.3.1
  conditions:
    ready: true
    serving: true
    terminating: false
  nodeName: node-c
  zone: bar
ports:
- name: http
  port: 80
  protocol: TCP
