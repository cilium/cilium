#! --lb-test-fault-probability=0.0

# Privileged mode uses real BPF maps, which are attached to the hive lifecycle.
# Stop this test in privileged mode because we can't simulate the agent restarting
# against BPF state that is not retained.
[privileged] stop

# Ensure HostPort entries survive the agent restart with the same IDs, while
# HostPorts changed or removed during the restart are still pruned.
db/insert node-addresses addrv4.yaml
hive/start

# Add a pod with 'hostPort'.
k8s/add pod.yaml
db/cmp frontends frontends.table

# Validate the BPF maps before the restart.
lb/maps-dump lbmaps.actual
* cmp lbmaps.expected lbmaps.actual

# Restart the agent.
hive/stop
hive/recreate
db/insert node-addresses addrv4.yaml
hive/start
test/init-wait

# The restored HostPort entries are kept with the same IDs since established
# connections refer to them via conntrack.
db/cmp frontends frontends.table
lb/maps-dump lbmaps.actual
* cmp lbmaps.expected lbmaps.actual

hive/stop

# Change the HostPort while the agent is stopped.
replace 'hostPort: 4444' 'hostPort: 5555' pod.yaml
k8s/update pod.yaml

hive/recreate
db/insert node-addresses addrv4.yaml
hive/start
test/init-wait

# The stale HostPort entries are pruned and the backend keeps its ID.
db/cmp frontends frontends-5555.table
lb/maps-dump lbmaps.actual
* cmp lbmaps-5555.expected lbmaps.actual

hive/stop

# Delete the pod while the agent is stopped.
k8s/delete pod.yaml

hive/recreate
db/insert node-addresses addrv4.yaml
hive/start
test/init-wait

# All of its entries are pruned.
* db/empty services frontends backends
* lb/maps-empty

hive/stop

#####

-- addrv4.yaml --
addr: 1.1.1.1
nodeport: true
primary: true
devicename: test

-- frontends.table --
Address           Type      Status  ServiceName                                                         Backends
0.0.0.0:4444/TCP  HostPort  Done    default/my-app:host-port:4444:11111111-2e9b-4c61-8454-ae81344876d8  10.244.1.113:80/TCP

-- frontends-5555.table --
Address           Type      Status  ServiceName                                                         Backends
0.0.0.0:5555/TCP  HostPort  Done    default/my-app:host-port:5555:11111111-2e9b-4c61-8454-ae81344876d8  10.244.1.113:80/TCP

-- pod.yaml --
apiVersion: v1
kind: Pod
metadata:
  name: my-app
  namespace: default
  uid: 11111111-2e9b-4c61-8454-ae81344876d8
spec:
  containers:
  - image: nginx
    name: my-app
    ports:
    - containerPort: 80
      hostPort: 4444
      protocol: TCP
  nodeName: testnode
status:
  phase: Running
  podIP: 10.244.1.113
  podIPs:
  - ip: 10.244.1.113

-- lbmaps.expected --
BE: ID=1 ADDR=10.244.1.113:80/TCP STATE=active
REV: ID=1 ADDR=0.0.0.0:4444
REV: ID=2 ADDR=1.1.1.1:4444
SVC: ID=1 ADDR=0.0.0.0:4444/TCP SLOT=0 LBALG=undef AFFTimeout=0 COUNT=1 QCOUNT=0 FLAGS=HostPort+non-routable
SVC: ID=1 ADDR=0.0.0.0:4444/TCP SLOT=1 BEID=1 COUNT=0 QCOUNT=0 FLAGS=HostPort+non-routable
SVC: ID=2 ADDR=1.1.1.1:4444/TCP SLOT=0 LBALG=undef AFFTimeout=0 COUNT=1 QCOUNT=0 FLAGS=HostPort
SVC: ID=2 ADDR=1.1.1.1:4444/TCP SLOT=1 BEID=1 COUNT=0 QCOUNT=0 FLAGS=HostPort
-- lbmaps-5555.expected --
BE: ID=1 ADDR=10.244.1.113:80/TCP STATE=active
REV: ID=3 ADDR=0.0.0.0:5555
REV: ID=4 ADDR=1.1.1.1:5555
SVC: ID=3 ADDR=0.0.0.0:5555/TCP SLOT=0 LBALG=undef AFFTimeout=0 COUNT=1 QCOUNT=0 FLAGS=HostPort+non-routable
SVC: ID=3 ADDR=0.0.0.0:5555/TCP SLOT=1 BEID=1 COUNT=0 QCOUNT=0 FLAGS=HostPort+non-routable
SVC: ID=4 ADDR=1.1.1.1:5555/TCP SLOT=0 LBALG=undef AFFTimeout=0 COUNT=1 QCOUNT=0 FLAGS=HostPort
SVC: ID=4 ADDR=1.1.1.1:5555/TCP SLOT=1 BEID=1 COUNT=0 QCOUNT=0 FLAGS=HostPort
