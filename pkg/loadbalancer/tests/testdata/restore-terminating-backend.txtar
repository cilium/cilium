#! --bpf-lb-algorithm=maglev --bpf-lb-external-clusterip=true --lb-test-fault-probability=0.0
# Test that a terminating and not serving backend sitting in the inactive tail
# of the service entry is restored as terminating and not as health-quarantined.

# Privileged mode uses real BPF maps, which are attached to the hive lifecycle.
# Stop this test in privileged mode because we can't simulate the agent restarting
# against BPF state that is not retained.
[privileged] stop

hive start

# The first backend is terminating but still serving, so it stays in rotation.
# The second is terminating and not serving, so it sits in the inactive tail.
cp endpointslice.yaml.tmpl endpointslice.yaml
replace '$READY1' 'false' endpointslice.yaml
replace '$SERVING1' 'true' endpointslice.yaml
replace '$TERM1' 'true' endpointslice.yaml
replace '$READY2' 'false' endpointslice.yaml
replace '$SERVING2' 'false' endpointslice.yaml
replace '$TERM2' 'true' endpointslice.yaml
k8s/add service.yaml endpointslice.yaml
db/cmp frontends frontends.table
db/cmp backends backends-terminating.table

# Check BPF maps
lb/maps-dump lbmaps.actual
* cmp lbmaps-terminating.expected lbmaps.actual

# Restart the agent. The replacement agent restores the IDs and the quarantine
# state from the retained maps and reconstructs the same contents from scratch.
hive stop
hive/recreate
hive start
test/init-wait
db/cmp frontends frontends.table
db/cmp backends backends-terminating.table

# Check BPF maps
lb/maps-dump lbmaps.actual
* cmp lbmaps-terminating.expected lbmaps.actual

# Set the first backend as not serving and second as ready+terminating.
# First backend will be kept but in maintenance and not load-balanced.
# The second backend will be just considered ready and its terminating
# condition is ignored ("ready" overrides everything). It must be load-balanced
# and not left quarantined by the restore.
cp endpointslice.yaml.tmpl endpointslice.yaml
replace '$READY1' 'false' endpointslice.yaml
replace '$SERVING1' 'false' endpointslice.yaml
replace '$TERM1' 'false' endpointslice.yaml
replace '$READY2' 'true' endpointslice.yaml
replace '$SERVING2' 'false' endpointslice.yaml
replace '$TERM2' 'true' endpointslice.yaml
k8s/update endpointslice.yaml
db/cmp frontends frontends.table
db/cmp backends backends-ready.table

# Check BPF maps
lb/maps-dump lbmaps.actual
* cmp lbmaps-ready.expected lbmaps.actual

# Cleanup
k8s/delete service.yaml endpointslice.yaml

# Tables and maps should be empty now
* db/empty services frontends backends
* lb/maps-empty

#####

-- frontends.table --
Address                 Type        ServiceName              Status  Backends
10.96.116.33:8081/TCP   ClusterIP   test/graceful-term-svc   Done    10.244.0.112:8081/TCP, 10.244.0.113:8081/TCP

-- backends-terminating.table --
Service                 Address                State                    NodeName
test/graceful-term-svc  10.244.0.112:8081/TCP  terminating              graceful-term-control-plane
test/graceful-term-svc  10.244.0.113:8081/TCP  terminating-not-serving  graceful-term-control-plane

-- backends-ready.table --
Service                 Address                State        NodeName
test/graceful-term-svc  10.244.0.112:8081/TCP  maintenance  graceful-term-control-plane
test/graceful-term-svc  10.244.0.113:8081/TCP  active       graceful-term-control-plane

