#! --probe-tcp-ao --test-peering-ips=10.99.13.101,10.99.13.102

# Misconfigurations between the two ends must never establish, and must recover
# once fixed without leaving the adapter in a wedged state.
#  1. algorithm mismatch
#  2. receiveID mismatch
#  3. sendKeyID pointing to a key the peer has no receive key for (on an established session)
#  4. master key mismatch fixed while the session is down (IDLE)

hive start
gobgp/add-server test gobgp-k1-sha256.toml
# Cilium uses hmac-sha-1-96 with the same master key -> MAC mismatch
k8s/add cilium-node.yaml bgp-node-config.yaml peer-k1-sha1.yaml secret-k1.yaml
# the session must not establish
sleep 6s
bgp/peers -o peers.actual --no-uptime
!* grep established peers.actual

##### 1. fix algorithm -> establishes
k8s/update peer-k1-sha256.yaml
gobgp/wait-state --timeout=30s 10.99.13.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-k1-opens1.expected peers.actual

##### 2. receiveID mismatch: Cilium key (send 1, recv 7) while GoBGP sends with key-id 1 -> Cilium drops GoBGP segments
k8s/update peer-k1-recv7.yaml
gobgp/wait-state --timeout=20s 10.99.13.102 IDLE
sleep 5s
gobgp/peers -o peers.actual
!* grep ESTABLISHED peers.actual
k8s/update peer-k1-sha256.yaml
gobgp/wait-state --timeout=30s 10.99.13.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-k1-opens2.expected peers.actual

##### 3. add key 2 only on Cilium and select it as send key: GoBGP can not verify key 2.
# RFC 5925: the peer ignores an unknown RNextKeyID, so the session must stay established
# with key 1 and the Cilium side shows key 2 as rnext but not current.
k8s/update peer-k1k2-send2.yaml secret-k1k2.yaml
sleep 4s
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-k1-opens2.expected peers.actual
bgp/peers --format=detailed -o d.actual --no-uptime
* grep --count=1 '^      Send Key ID: 2$' d.actual
* grep --count=1 '^        Send ID 1 / Receive ID 1 \(current\):$' d.actual
* grep --count=1 '^        Send ID 2 / Receive ID 2 \(rnext\):$' d.actual
# now GoBGP learns key 2 and switches to it -> hitless completion
gobgp/reload-server test gobgp-k1k2-send2.toml
gobgp/wait-state 10.99.13.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-k1k2-send2-opens2.expected peers.actual
bgp/peers --format=detailed -o d.actual --no-uptime
* grep --count=1 '^        Send ID 2 / Receive ID 2 \(current, rnext\):$' d.actual

##### 4. wrong master key for in-use key 2 -> down; fix while IDLE -> up again
k8s/update secret-k1-k2wrong.yaml
gobgp/wait-state --timeout=20s 10.99.13.102 IDLE
# Also remove key 1 while down (on both sides) so recovery relies purely on key 2
k8s/update peer-k2-send2.yaml secret-k2.yaml
gobgp/reload-server test gobgp-k2.toml
gobgp/wait-state --timeout=30s 10.99.13.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-k2-opens3.expected peers.actual

#####

-- gobgp-k1-sha256.toml --
[global.config]
  as = 65010
  router-id = "10.99.13.101"
  local-address-list = ["10.99.13.101"]
  port = 1790
[[keychains]]
  [keychains.config]
    name = "cilium"
  [[keychains.keys]]
    [keychains.keys.config]
      key-id = 1
      receive-id = 1
      crypto-algorithm = "hmac-sha-256-128"
      secret-key = "Q2lsaXVtMTIz"
[[neighbors]]
  [neighbors.config]
    neighbor-address = "10.99.13.102"
    peer-as = 65001
  [neighbors.transport.config]
    passive-mode = true
  [neighbors.tcp-ao.config]
    keychain = "cilium"
    send-id = 1
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv4-unicast"

-- gobgp-k1k2-send2.toml --
[global.config]
  as = 65010
  router-id = "10.99.13.101"
  local-address-list = ["10.99.13.101"]
  port = 1790
[[keychains]]
  [keychains.config]
    name = "cilium"
  [[keychains.keys]]
    [keychains.keys.config]
      key-id = 1
      receive-id = 1
      crypto-algorithm = "hmac-sha-256-128"
      secret-key = "Q2lsaXVtMTIz"
  [[keychains.keys]]
    [keychains.keys.config]
      key-id = 2
      receive-id = 2
      crypto-algorithm = "hmac-sha-1-96"
      secret-key = "Q2lsaXVtNDU2"
[[neighbors]]
  [neighbors.config]
    neighbor-address = "10.99.13.102"
    peer-as = 65001
  [neighbors.transport.config]
    passive-mode = true
  [neighbors.tcp-ao.config]
    keychain = "cilium"
    send-id = 2
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv4-unicast"

-- gobgp-k2.toml --
