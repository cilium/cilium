-- peer-k1k2-send2.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: gobgp-peer-config
spec:
  transport:
    peerPort: 1790
  tcpAO:
    secretRef: s
    sendKeyID: 2
    keys:
    - sendID: 1
      receiveID: 1
      algorithm: hmac-sha-256-128
    - sendID: 2
      receiveID: 2
      algorithm: hmac-sha-1-96
  timers:
    connectRetryTimeSeconds: 1
    holdTimeSeconds: 9
    keepAliveTimeSeconds: 3
  families:
  - afi: ipv4
    safi: unicast

