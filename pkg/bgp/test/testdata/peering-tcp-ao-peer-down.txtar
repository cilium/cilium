#! --probe-tcp-ao --test-peering-ips=10.99.14.101,10.99.14.102

# Keychain changes while the session is down (peer unreachable), and peer-side key removal.
#  A. peer disappears; Cilium rotates key 1 -> key 2 (remove+add+sendKeyID) while down; peer returns with key 2.
#  B. peer disappears; Cilium adds key 3 and prefers it while down; peer returns with keys 2+3 but sends with 2.
#  C. peer (passive GoBGP) deletes the key Cilium sends with -> session dies at hold timer, Cilium
#     keeps retrying, and recovers once Cilium switches keys.

hive start
gobgp/add-server test gobgp-k1.toml
k8s/add cilium-node.yaml bgp-node-config.yaml peer-k1.yaml secret-k1.yaml
gobgp/wait-state 10.99.14.102 ESTABLISHED

##### A
gobgp/delete-server test
# the session goes down
bgp/peers -o peers.actual --no-uptime
!* grep established peers.actual
# rotate to key 2 while the peer is down, then the peer comes back with key 2 only
k8s/update peer-k2.yaml secret-k2.yaml
sleep 2s
gobgp/add-server test gobgp-k2.toml
# the session comes up with key 2
gobgp/wait-state --timeout=30s 10.99.14.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-k2-opens1.expected peers.actual
bgp/peers --format=detailed -o d.actual --no-uptime
* grep --count=1 '^        Send ID 2 / Receive ID 2 \(current, rnext\):$' d.actual
!* grep 'Send ID 1 / Receive ID 1' d.actual

##### B
gobgp/delete-server test
# the session goes down
bgp/peers -o peers.actual --no-uptime
!* grep established peers.actual
# add key 3 and prefer it while the peer is down, then the peer comes back with keys 2+3, sending with 2
k8s/update peer-k2k3-send3.yaml secret-k2k3.yaml
sleep 2s
gobgp/add-server test gobgp-k2k3-send2.toml
# Cilium prefers 3, GoBGP prefers 2: per RFC 5925 each side ends up sending with the key the
# other side requested: GoBGP current=3/rnext=2, Cilium current=2/rnext=3.
gobgp/wait-state --timeout=30s 10.99.14.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-k2k3-send2-opens1.expected peers.actual
bgp/peers --format=detailed -o d.actual --no-uptime
* grep --count=1 '^        Send ID 3 / Receive ID 3 \(rnext\):$' d.actual
* grep --count=1 '^        Send ID 2 / Receive ID 2 \(current\):$' d.actual

##### C: GoBGP drops key 3 (the key Cilium sends with) and keeps only key 2.
# GoBGP refuses to delete the key that is current on its socket (kernel EBUSY) but updates its keychain,
# so the established TCP session should survive; but what does Cilium see?
gobgp/reload-server test gobgp-k2-send2.toml
sleep 5s
gobgp/peers --tcp-ao -o peers.actual
cat peers.actual
bgp/peers --format=detailed -o d.actual --no-uptime
cat d.actual
# Cilium switches to key 2 and removes key 3 -> whatever state GoBGP is in, both sides must converge on key 2.
k8s/update peer-k2.yaml secret-k2.yaml
gobgp/wait-state --timeout=30s 10.99.14.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
cat peers.actual
* grep 'ESTABLISHED.* 2/2\(current,rnext\)$' peers.actual
bgp/peers --format=detailed -o d.actual --no-uptime
* grep --count=1 '^        Send ID 2 / Receive ID 2 \(current, rnext\):$' d.actual
!* grep 'Send ID 3 / Receive ID 3' d.actual

#####

-- gobgp-k1.toml --
[global.config]
  as = 65010
  router-id = "10.99.14.101"
  local-address-list = ["10.99.14.101"]
  port = 1790
[[keychains]]
  [keychains.config]
    name = "cilium"
  [[keychains.keys]]
    [keychains.keys.config]
      key-id = 1
      receive-id = 1
      crypto-algorithm = "hmac-sha-1-96"
      secret-key = "Q2lsaXVtMTIz"
[[neighbors]]
  [neighbors.config]
    neighbor-address = "10.99.14.102"
    peer-as = 65001
  [neighbors.transport.config]
    passive-mode = true
  [neighbors.tcp-ao.config]
    keychain = "cilium"
    send-id = 1
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv4-unicast"

