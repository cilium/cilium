-- cilium-node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  name: test-node
spec:
  addresses:
  - ip: 10.99.14.102
    type: InternalIP
  ipam:
    podCIDRs:
    - 10.244.0.0/24

-- bgp-node-config.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPNodeConfig
metadata:
  name: test-node
spec:
  bgpInstances:
  - localASN: 65001
    routerID: 10.99.14.102
    name: tor
    peers:
    - name: gobgp-peer
      peerASN: 65010
      peerAddress: 10.99.14.101
      localAddress: 10.99.14.102
      peerConfigRef:
        name: gobgp-peer-config

-- peer-k1.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: gobgp-peer-config
spec:
  transport:
    peerPort: 1790
  tcpAO:
    secretRef: s
    keys:
    - sendID: 1
      receiveID: 1
  timers:
    connectRetryTimeSeconds: 1
    holdTimeSeconds: 9
    keepAliveTimeSeconds: 3
  families:
  - afi: ipv4
    safi: unicast

-- peer-k2.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: gobgp-peer-config
spec:
  transport:
    peerPort: 1790
  tcpAO:
    secretRef: s
    keys:
    - sendID: 2
      receiveID: 2
  timers:
    connectRetryTimeSeconds: 1
    holdTimeSeconds: 9
    keepAliveTimeSeconds: 3
  families:
  - afi: ipv4
    safi: unicast

-- peer-k2k3-send3.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: gobgp-peer-config
spec:
  transport:
    peerPort: 1790
  tcpAO:
    secretRef: s
    sendKeyID: 3
    keys:
    - sendID: 2
      receiveID: 2
    - sendID: 3
      receiveID: 3
  timers:
    connectRetryTimeSeconds: 1
    holdTimeSeconds: 9
    keepAliveTimeSeconds: 3
  families:
  - afi: ipv4
    safi: unicast

-- secret-k1.yaml --
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: s
  namespace: kube-system
data:
  key-1: Q2lsaXVtMTIz

-- secret-k2.yaml --
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: s
  namespace: kube-system
data:
  key-2: Q2lsaXVtNDU2

-- secret-k2k3.yaml --
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: s
  namespace: kube-system
data:
  key-2: Q2lsaXVtNDU2
  key-3: Q2lsaXVtNzg5

-- gobgp-k2-opens1.expected --
PeerAddress    RouterID       PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.14.102   10.99.14.102   65001     ESTABLISHED    3           9          0                     1       2/2(current,rnext)
-- gobgp-k2k3-send2-opens1.expected --
PeerAddress    RouterID       PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.14.102   10.99.14.102   65001     ESTABLISHED    3           9          0                     1       2/2(rnext) 3/3(current)
