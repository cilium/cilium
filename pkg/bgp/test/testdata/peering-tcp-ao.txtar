-- gobgp-peers-key1.expected --
PeerAddress   RouterID      PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.9.102   10.99.9.102   65001     ESTABLISHED    3           9          0                     1       1/1(current,rnext)
-- gobgp-peers-key1-key2.expected --
PeerAddress   RouterID      PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.9.102   10.99.9.102   65001     ESTABLISHED    3           9          0                     1       1/1(current,rnext) 2/2
-- gobgp-peers-key1-key2-send2-cilium.expected --
PeerAddress   RouterID      PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.9.102   10.99.9.102   65001     ESTABLISHED    3           9          0                     1       1/1(rnext) 2/2(current)
-- gobgp-peers-key1-key2-send2.expected --
PeerAddress   RouterID      PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.9.102   10.99.9.102   65001     ESTABLISHED    3           9          0                     1       1/1 2/2(current,rnext)
-- gobgp-peers-key2.expected --
PeerAddress   RouterID      PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.9.102   10.99.9.102   65001     ESTABLISHED    3           9          0                     1       2/2(current,rnext)
-- gobgp-peers-key2-reset.expected --
PeerAddress   RouterID      PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.9.102   10.99.9.102   65001     ESTABLISHED    3           9          0                     2       2/2(current,rnext)
-- gobgp-routes-ipv4.expected --
Prefix          NextHop       Attrs
10.244.0.0/24   10.99.9.102   [{Origin: i} {AsPath: 65001} {Nexthop: 10.99.9.102}]
