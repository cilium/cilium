#! --probe-tcp-ao --test-peering-ips=fd00::aa:bb:cc:201,fd00::aa:bb:cc:202

# IPv6 peering, boundary key IDs (0 and 255), asymmetric send/receive IDs,
# aes-128-cmac-96 and hmac-sha-256-96, excludeTCPOptions, 80-byte and 1-byte master keys,
# plus a rotation 0 -> 255 over IPv6.
#
# Cilium key A: sendID 0,   receiveID 255, aes-128-cmac-96, excludeTCPOptions, 80-byte key
# Cilium key B: sendID 255, receiveID 0,   hmac-sha-256-96, 1-byte key
# GoBGP mirror: key-id 255/receive-id 0 (A), key-id 0/receive-id 255 (B)

hive start
gobgp/add-server test gobgp-ab-send255.toml
k8s/add cilium-node.yaml bgp-node-config.yaml peer-ab-send0.yaml secret-ab.yaml bgp-advertisement.yaml
# wait for the session to come up and check its state
gobgp/wait-state fd00::aa:bb:cc:202 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-ab-send255.expected peers.actual

gobgp/routes -o routes.actual ipv6 unicast
* cmp gobgp-routes-ipv6.expected routes.actual

bgp/peers --format=detailed -o d.actual --no-uptime
* grep --count=1 '^      Send Key ID: 0$' d.actual
* grep --count=1 '^        Send ID 0 / Receive ID 255 \(current, rnext\):$' d.actual
* grep --count=1 '^        Send ID 255 / Receive ID 0:$' d.actual
* grep --count=2 '^          Packets Bad: 0$' d.actual
* grep --count=1 '^      Packets Key Not Found: 0$' d.actual

##### Rotate: Cilium sends with 255, GoBGP sends with 0 (hitless)
k8s/update peer-ab-send255.yaml
gobgp/reload-server test gobgp-ab-send0.toml
gobgp/wait-state fd00::aa:bb:cc:202 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-ab-send0.expected peers.actual
bgp/peers --format=detailed -o d.actual --no-uptime
* grep --count=1 '^        Send ID 255 / Receive ID 0 \(current, rnext\):$' d.actual
* grep --count=1 '^        Send ID 0 / Receive ID 255:$' d.actual

##### Remove key A on both sides: hitless, it is not in use on either side after the rotate.
k8s/update peer-b-send255.yaml secret-b.yaml
gobgp/reload-server test gobgp-b-send0.toml
gobgp/wait-state fd00::aa:bb:cc:202 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-b-send0.expected peers.actual
bgp/peers --format=detailed -o d.actual --no-uptime
!* grep 'Send ID 0 / Receive ID 255' d.actual

##### Change only excludeTCPOptions of the in-use key on Cilium (GoBGP unchanged): reset + must NOT establish
k8s/update peer-b-send255-excl.yaml
gobgp/wait-state --timeout=20s fd00::aa:bb:cc:202 IDLE
sleep 5s
gobgp/peers -o peers.actual
!* grep ESTABLISHED peers.actual
# match it on GoBGP (restart the server: an in-use key's exclude-tcp-options can not be
# changed via GoBGP's in-place reload, just like its master key) -> establishes
gobgp/delete-server test
gobgp/add-server test gobgp-b-send0-excl.toml
gobgp/wait-state --timeout=30s fd00::aa:bb:cc:202 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* grep 'ESTABLISHED.* 0/255\(current,rnext\)$' peers.actual

#####

-- gobgp-ab-send255.toml --
[global.config]
  as = 65010
  router-id = "10.0.0.1"
  local-address-list = ["fd00::aa:bb:cc:201"]
  port = 1790
[[keychains]]
  [keychains.config]
    name = "cilium"
  [[keychains.keys]]
    [keychains.keys.config]
      key-id = 255
      receive-id = 0
      crypto-algorithm = "aes-128-cmac-96"
      exclude-tcp-options = true
      secret-key = "S0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0s="
  [[keychains.keys]]
    [keychains.keys.config]
      key-id = 0
      receive-id = 255
      crypto-algorithm = "hmac-sha-256-96"
      secret-key = "QQ=="
[[neighbors]]
  [neighbors.config]
    neighbor-address = "fd00::aa:bb:cc:202"
    peer-as = 65001
  [neighbors.transport.config]
    passive-mode = true
  [neighbors.tcp-ao.config]
    keychain = "cilium"
    send-id = 255
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv6-unicast"

