-- secret-ab.yaml --
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: s
  namespace: kube-system
data:
  a: S0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLS0s=
  b: QQ==

