#! --probe-tcp-ao --test-peering-ips=10.99.11.101,10.99.11.102

# Rapid, back-to-back configuration churn on an established TCP-AO session.
# Every section ends with an assertion of the converged state and of the OPEN counter
# ('Opens') which tells how many TCP sessions GoBGP saw.

hive start
gobgp/add-server test gobgp-k1k2-send1.toml
k8s/add cilium-node.yaml bgp-node-config.yaml peer-k1k2-send1.yaml secret-k1k2.yaml
# wait for the session to come up and check its state
gobgp/wait-state 10.99.11.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-k1k2-send1-opens1.expected peers.actual

##### A. sendKeyID ping-pong 1->2->1->2->1->2 with no waiting in between, then GoBGP follows.
k8s/update peer-k1k2-send2.yaml
k8s/update peer-k1k2-send1.yaml
k8s/update peer-k1k2-send2.yaml
k8s/update peer-k1k2-send1.yaml
k8s/update peer-k1k2-send2.yaml
gobgp/reload-server test gobgp-k1k2-send2.toml
gobgp/wait-state 10.99.11.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* cmp gobgp-k1k2-send2-opens1.expected peers.actual
bgp/peers --format=detailed -o d.actual --no-uptime
* grep --count=1 '^      Send Key ID: 2$' d.actual
* grep --count=1 '^        Send ID 2 / Receive ID 2 \(current, rnext\):$' d.actual
* grep --count=1 '^        Send ID 1 / Receive ID 1:$' d.actual

##### B. transient invalid secret: config references key 3 while the Secret still lacks key-3.
# The Secret and the config being inconsistent is a normal transient state in the middle of a
# rotation (they are updated one after the other): the established peer must be left untouched
# (no reset, no key change), and once the Secret is fixed the key must be added hitlessly.
gobgp/reload-server test gobgp-k1k2k3-send2.toml
k8s/update peer-k1k2k3-send2.yaml secret-k1k2.yaml
sleep 3s
bgp/peers -o peers.actual --no-uptime
grep established peers.actual
bgp/peers --format=detailed -o d.actual --no-uptime
grep --count=2 '^        Send ID [0-9]* / Receive ID [0-9]*' d.actual
! grep 'Send ID 3 / Receive ID 3' d.actual
gobgp/peers --tcp-ao -o peers.actual
grep 'ESTABLISHED.* 0 +1 +1/1 2/2\(current,rnext\) 3/3$' peers.actual

# provide key-3 -> added hitlessly (Opens stays 1), and the state stays converged
k8s/update secret-k1k2k3.yaml
bgp/peers --format=detailed -o d.actual --no-uptime
* grep --count=3 '^        Send ID [0-9]* / Receive ID [0-9]*' d.actual
* grep --count=1 '^        Send ID 3 / Receive ID 3:$' d.actual
sleep 5s
gobgp/peers --tcp-ao -o peers.actual
grep 'ESTABLISHED.* 0 +1 +1/1 2/2\(current,rnext\) 3/3$' peers.actual

##### C. change the master key of key 1 (not in use) three times in a row: hitless.
gobgp/peers --tcp-ao -o before.actual
k8s/update secret-k1a-k2k3.yaml
k8s/update secret-k1b-k2k3.yaml
k8s/update secret-k1k2k3.yaml
sleep 3s
# key 1 is not in use, so all three changes are hitless: no reset, same session as before.
gobgp/peers --tcp-ao -o peers.actual
* grep 'ESTABLISHED.* 1/1 2/2\(current,rnext\) 3/3$' peers.actual
* cmp before.actual peers.actual

##### D. change the master key of key 2 (in use) and change it back: Cilium resets each time.
# GoBGP can not change the content of its own preferred send key in place (its UpdateConfig
# rejects it, just like Cilium resets), so the peer side is restarted to pick up the new key.
# Opens restarts at 1 on each GoBGP restart, so the TCPAOKeys suffix is matched instead of Opens.
k8s/update secret-k1-k2x-k3.yaml
gobgp/delete-server test
gobgp/add-server test gobgp-k1-k2x-k3-send2.toml
gobgp/wait-state --timeout=30s 10.99.11.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* grep 'ESTABLISHED.* 1/1 2/2\(current,rnext\) 3/3$' peers.actual
k8s/update secret-k1k2k3.yaml
gobgp/delete-server test
gobgp/add-server test gobgp-k1k2k3-send2.toml
gobgp/wait-state --timeout=30s 10.99.11.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* grep 'ESTABLISHED.* 1/1 2/2\(current,rnext\) 3/3$' peers.actual

##### E. peer-first rotation order 2 -> 3: GoBGP switches send-id to 3 first (hitless reload), then Cilium.
gobgp/reload-server test gobgp-k1k2k3-send3.toml
# Cilium is asked to send with key 3: current=3 while Cilium still requests 2 from GoBGP (rnext=2).
bgp/peers --format=detailed -o d.actual --no-uptime
* grep --count=1 '^        Send ID 3 / Receive ID 3 \(current\):$' d.actual
* grep --count=1 '^        Send ID 2 / Receive ID 2 \(rnext\):$' d.actual
# Now Cilium: sendKeyID 3 AND remove key 2 in the same update. Key 2 is rnext on Cilium -> reset expected.
k8s/update peer-k1k3-send3.yaml secret-k1k3.yaml
gobgp/delete-server test
gobgp/add-server test gobgp-k1k3-send3.toml
gobgp/wait-state --timeout=30s 10.99.11.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* grep 'ESTABLISHED.* 1/1 3/3\(current,rnext\)$' peers.actual

##### F. swap master keys between key 1 and key 3 (3 is in use): Cilium resets, then both sides agree.
k8s/update secret-k1k3-swapped.yaml
gobgp/delete-server test
gobgp/add-server test gobgp-k1k3-send3-swapped.toml
# the peer comes back with a fresh session
gobgp/wait-state --timeout=30s 10.99.11.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* grep 'ESTABLISHED.* 1/1 3/3\(current,rnext\)$' peers.actual

##### G. remove the peer config entirely and re-add it while the Secret stays -> clean re-add.
k8s/delete peer-k1k3-send3.yaml
gobgp/wait-state --timeout=20s 10.99.11.102 IDLE
k8s/add peer-k1k3-send3.yaml
# the peer comes back with a fresh session
gobgp/wait-state --timeout=30s 10.99.11.102 ESTABLISHED
gobgp/peers --tcp-ao -o peers.actual
* grep 'ESTABLISHED.* 1/1 3/3\(current,rnext\)$' peers.actual

#####

-- gobgp-k1k2-send1.toml --
[global.config]
  as = 65010
  router-id = "10.99.11.101"
  local-address-list = ["10.99.11.101"]
  port = 1790
[[keychains]]
  [keychains.config]
    name = "cilium"
  [[keychains.keys]]
    [keychains.keys.config]
      key-id = 1
      receive-id = 1
      crypto-algorithm = "hmac-sha-1-96"
      secret-key = "Q2lsaXVtMTIz"
  [[keychains.keys]]
    [keychains.keys.config]
      key-id = 2
      receive-id = 2
      crypto-algorithm = "hmac-sha-256-128"
      secret-key = "Q2lsaXVtNDU2"
[[neighbors]]
  [neighbors.config]
    neighbor-address = "10.99.11.102"
    peer-as = 65001
  [neighbors.transport.config]
    passive-mode = true
  [neighbors.tcp-ao.config]
    keychain = "cilium"
    send-id = 1
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv4-unicast"

