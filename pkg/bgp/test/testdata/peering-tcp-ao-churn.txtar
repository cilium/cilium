-- cilium-node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  name: test-node
spec:
  addresses:
  - ip: 10.99.11.102
    type: InternalIP
  ipam:
    podCIDRs:
    - 10.244.0.0/24

-- bgp-node-config.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPNodeConfig
metadata:
  name: test-node
spec:
  bgpInstances:
  - localASN: 65001
    routerID: 10.99.11.102
    name: tor
    peers:
    - name: gobgp-peer
      peerASN: 65010
      peerAddress: 10.99.11.101
      localAddress: 10.99.11.102
      peerConfigRef:
        name: gobgp-peer-config

-- peer-k1k2-send1.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: gobgp-peer-config
spec:
  transport:
    peerPort: 1790
  tcpAO:
    secretRef: s
    sendKeyID: 1
    keys:
    - sendID: 1
      receiveID: 1
      algorithm: hmac-sha-1-96
    - sendID: 2
      receiveID: 2
      algorithm: hmac-sha-256-128
  timers:
    connectRetryTimeSeconds: 1
    holdTimeSeconds: 9
    keepAliveTimeSeconds: 3
  families:
  - afi: ipv4
    safi: unicast

