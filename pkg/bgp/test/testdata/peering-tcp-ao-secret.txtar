#! --probe-tcp-ao --test-peering-ips=10.99.10.101,10.99.10.102,10.99.10.103

# Tests the TCP-AO Secret lifecycle with two peers in a single BGP instance:
#   peer-ao    -> gobgp A (10.99.10.101) authenticated with TCP-AO
#   peer-plain -> gobgp B (10.99.10.103) not authenticated
#
# The key property is that a missing or invalid TCP-AO Secret of one peer must never prevent
# the other peers of the same instance from being reconciled. A missing Secret fails closed
# for that peer (it is not configured). An invalid Secret (one that does not yield a valid
# keychain for the peer config) does not configure a new peer, but leaves an already
# established peer untouched, as this is a normal transient state of a key rotation. It covers:
#   1. Secret present but missing the master key entry -> peer-ao not configured, peer-plain up.
#   2. Secret fixed -> peer-ao comes up, peer-plain untouched.
#   3. Secret deleted -> peer-ao removed (fail closed), peer-plain stays up.
#   4. Oversized (invalid) master key on an established peer -> peer-ao left unchanged,
#      peer-plain stays up and remains reconfigurable while peer-ao's Secret is broken.
#   5. Deleting the peer config / Secret cleans up peer-ao without affecting peer-plain.

hive start

gobgp/add-server a gobgp-a.toml
gobgp/add-server b gobgp-b.toml

# Secret exists but has entry key-9 instead of key-1 -> master key missing for peer-ao
k8s/add cilium-node.yaml bgp-node-config.yaml bgp-peer-config-ao.yaml bgp-peer-config-plain.yaml secret-missing-entry.yaml

# The plain peer must come up regardless of peer-ao's broken Secret
gobgp/wait-state --timeout=20s 10.99.10.102 ESTABLISHED -s b

# peer-ao must not be established
gobgp/peers -o peers-a.actual -s a
!* grep ESTABLISHED peers-a.actual

##### Fix the Secret -> peer-ao comes up, plain peer untouched (Opens stays 1)
k8s/update secret-key1.yaml
gobgp/wait-state 10.99.10.102 ESTABLISHED -s a
gobgp/peers --tcp-ao -o peers-a.actual -s a
* cmp gobgp-a-key1.expected peers-a.actual
gobgp/peers --tcp-ao -o peers-b.actual -s b
* cmp gobgp-b-opens1.expected peers-b.actual

##### Delete the Secret -> peer-ao removed (fail closed), plain peer still up
k8s/delete secret-key1.yaml
gobgp/wait-state --timeout=20s 10.99.10.102 IDLE -s a
gobgp/peers --tcp-ao -o peers-b.actual -s b
* cmp gobgp-b-opens1.expected peers-b.actual

bgp/peers -o peers.actual --no-uptime
* cmp cilium-peers-plain-only.expected peers.actual

##### Re-create the Secret -> peer-ao back (new TCP session: Opens 2 on A)
k8s/add secret-key1.yaml
# peer-ao comes back with a fresh session, the plain peer is untouched
gobgp/wait-state --timeout=30s 10.99.10.102 ESTABLISHED -s a
gobgp/peers --tcp-ao -o peers-a.actual -s a
* cmp gobgp-a-key1-opens2.expected peers-a.actual
gobgp/peers --tcp-ao -o peers-b.actual -s b
* cmp gobgp-b-opens1.expected peers-b.actual

##### Oversized (81 bytes) master key: the Secret no longer yields a valid keychain for the
##### established peer-ao -> peer-ao is left unchanged (not reset), and the plain peer of the
##### same instance must stay up and must remain changeable.
k8s/update secret-key1-81.yaml

# while peer-ao's Secret is invalid, the plain peer must still be reconfigurable
# (hold time 9 -> 18 on plain peer) -> proves the broken peer does not block its siblings
k8s/update bgp-peer-config-plain-hold18.yaml
gobgp/wait-state --timeout=30s 10.99.10.102 ESTABLISHED -s b
gobgp/peers --tcp-ao -o peers-b.actual -s b
* cmp gobgp-b-hold18.expected peers-b.actual

# peer-ao is still up on the same session with the previously applied key
gobgp/peers --tcp-ao -o peers-a.actual -s a
cmp gobgp-a-key1-opens2.expected peers-a.actual

# restore a good key -> nothing changes, still the same session
k8s/update secret-key1.yaml
sleep 2s
gobgp/peers --tcp-ao -o peers-a.actual -s a
cmp gobgp-a-key1-opens2.expected peers-a.actual

##### Delete Secret, then delete the peer config, then node config peer -> clean removal
k8s/delete secret-key1.yaml
gobgp/wait-state --timeout=20s 10.99.10.102 IDLE -s a
k8s/delete bgp-peer-config-ao.yaml
sleep 1s
bgp/peers -o peers.actual --no-uptime
* cmp cilium-peers-plain-only.expected peers.actual

# bring everything back
k8s/add bgp-peer-config-ao.yaml secret-key1.yaml
gobgp/wait-state --timeout=30s 10.99.10.102 ESTABLISHED -s a

#####

-- gobgp-a.toml --
[global.config]
  as = 65010
  router-id = "10.99.10.101"
  local-address-list = ["10.99.10.101"]
  port = 1790

[[keychains]]
  [keychains.config]
    name = "cilium"
  [[keychains.keys]]
    [keychains.keys.config]
      key-id = 1
      receive-id = 1
      crypto-algorithm = "hmac-sha-1-96"
      secret-key = "Q2lsaXVtMTIz"

[[neighbors]]
  [neighbors.config]
    neighbor-address = "10.99.10.102"
    peer-as = 65001
  [neighbors.transport.config]
    passive-mode = true
  [neighbors.tcp-ao.config]
    keychain = "cilium"
    send-id = 1
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv4-unicast"

-- gobgp-b.toml --
[global.config]
  as = 65011
  router-id = "10.99.10.103"
  local-address-list = ["10.99.10.103"]
  port = 1790

[[neighbors]]
  [neighbors.config]
    neighbor-address = "10.99.10.102"
    peer-as = 65001
  [neighbors.transport.config]
    passive-mode = true
  [[neighbors.afi-safis]]
    [neighbors.afi-safis.config]
      afi-safi-name = "ipv4-unicast"

-- cilium-node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  name: test-node
spec:
  addresses:
  - ip: 10.99.10.102
    type: InternalIP
  ipam:
    podCIDRs:
    - 10.244.0.0/24

-- bgp-node-config.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPNodeConfig
metadata:
  name: test-node
spec:
  bgpInstances:
  - localASN: 65001
    routerID: 10.99.10.102
    name: tor
    peers:
    - name: peer-ao
      peerASN: 65010
      peerAddress: 10.99.10.101
      localAddress: 10.99.10.102
      peerConfigRef:
        name: peer-config-ao
    - name: peer-plain
      peerASN: 65011
      peerAddress: 10.99.10.103
      localAddress: 10.99.10.102
      peerConfigRef:
        name: peer-config-plain

-- bgp-peer-config-ao.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: peer-config-ao
spec:
  transport:
    peerPort: 1790
  tcpAO:
    secretRef: bgp-tcp-ao-secret
    keys:
    - sendID: 1
      receiveID: 1
  timers:
    connectRetryTimeSeconds: 1
    holdTimeSeconds: 9
    keepAliveTimeSeconds: 3
  families:
  - afi: ipv4
    safi: unicast

-- bgp-peer-config-plain.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: peer-config-plain
spec:
  transport:
    peerPort: 1790
  timers:
    connectRetryTimeSeconds: 1
    holdTimeSeconds: 9
    keepAliveTimeSeconds: 3
  families:
  - afi: ipv4
    safi: unicast

-- bgp-peer-config-plain-hold18.yaml --
apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: peer-config-plain
spec:
  transport:
    peerPort: 1790
  timers:
    connectRetryTimeSeconds: 1
    holdTimeSeconds: 18
    keepAliveTimeSeconds: 6
  families:
  - afi: ipv4
    safi: unicast

-- secret-missing-entry.yaml --
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: bgp-tcp-ao-secret
  namespace: kube-system
data:
  key-9: Q2lsaXVtMTIz

-- secret-key1.yaml --
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: bgp-tcp-ao-secret
  namespace: kube-system
data:
  key-1: Q2lsaXVtMTIz

-- secret-key1-81.yaml --
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: bgp-tcp-ao-secret
  namespace: kube-system
data:
  key-1: TExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExM

-- gobgp-a-key1.expected --
PeerAddress    RouterID       PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.10.102   10.99.10.102   65001     ESTABLISHED    3           9          0                     1       1/1(current,rnext)
-- gobgp-a-key1-opens2.expected --
PeerAddress    RouterID       PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.10.102   10.99.10.102   65001     ESTABLISHED    3           9          0                     2       1/1(current,rnext)
-- gobgp-b-opens1.expected --
PeerAddress    RouterID       PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.10.102   10.99.10.102   65001     ESTABLISHED    3           9          0                     1       -
-- gobgp-b-hold18.expected --
PeerAddress    RouterID       PeerASN   SessionState   KeepAlive   HoldTime   GracefulRestartTime   Opens   TCPAOKeys
10.99.10.102   10.99.10.102   65001     ESTABLISHED    6           18         0                     2       -
-- cilium-peers-plain-only.expected --
Instance   Peer         Session State   Uptime   Family         Received   Accepted   Advertised
tor        peer-plain   established     -        ipv4-unicast   0          0          0
