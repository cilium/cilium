hive start

db/insert k8s-cilium-resource-netconfigs netconfig.yaml
k8s/add ippool.yaml node.yaml claim.yaml
driver/ipam/restore-finished

# Prepare claim
# Just like in a real cluster, this is retried until successful. An initial failure
# is not an error: as an example, when referencing a CiliumResourceIPPool, the address
# allocation fails until the operator assigns a CIDR to the node.
* driver/prepare-resource-claims default/test-claim

# The addresses are allocated from the pool of the claim.
driver/check-claim-addresses default/test-claim test-device test-ip-pool

# The prefix lengths and the static routes are the ones of the network config entries containing the
# addresses (not the ones of the pool CIDRs), and they are recorded in the claim status.
k8s/get resource.k8s.io.v1.resourceclaims default/test-claim -o claim.actual.yaml
grep --count=1 '^      - 10\.10\.0\.[0-9]+/24$' claim.actual.yaml
grep --count=1 '^      - fd00:200:1:[0-9a-f:]+/56$' claim.actual.yaml
grep --count=1 'destination: 10\.50\.0\.0/16' claim.actual.yaml
grep --count=1 'destination: fd00:300::/48' claim.actual.yaml

# Unprepare the claim
driver/unprepare-resource-claims default/test-claim

# Check CiliumNode resource pools after release
# `resourcePools: {}` will be an empty slice not `nil`.
k8s/get cilium.io.v2.ciliumnodes test-local-node -o node-released.actual.yaml
* cmp node-released.actual.yaml node-released.expected.yaml

hive stop

-- netconfig.yaml --
name: test-network-config
spec:
  ipv4:
  - cidr: 10.10.0.0/16
    prefixLength: 24
    routes:
    - destination: 10.50.0.0/16
      gateway: 10.10.0.254
  ipv6:
  - cidr: fd00:200:1::/48
    prefixLength: 56
    routes:
    - destination: fd00:300::/48
      gateway: fd00:200:1::fe

-- ippool.yaml --
apiVersion: cilium.io/v2alpha1
kind: CiliumResourceIPPool
metadata:
  name: test-ip-pool
spec:
  ipv4:
    cidrs:
    - 10.10.0.0/16
    maskSize: 24
  ipv6:
    cidrs:
    - fd00:200:1::/48
    maskSize: 64

-- node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  name: test-local-node
  labels:
    kubernetes.io/hostname: test-local-node
spec: {}

-- claim.yaml --
apiVersion: resource.k8s.io/v1
kind: ResourceClaim
metadata:
  name: test-claim
  namespace: default
  uid: ba3c7922-9a56-44eb-a96f-84ee8b74dd23
spec: {}
status:
  allocation:
    devices:
      config:
      - source: FromClaim
        requests:
        - test-request
        opaque:
          driver: networkdriver.cilium.io
          parameters:
            ipPool: test-ip-pool
            networkConfig: test-network-config
      results:
      - device: test-device
        driver: networkdriver.cilium.io
        pool: test-device-pool
        request: test-request
  reservedFor:
  - resource: pods
    name: test-pod
    uid: bec9dd67-13f9-4d4b-a3c1-76fc3e485e68

-- node-released.expected.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  labels:
    kubernetes.io/hostname: test-local-node
  name: test-local-node
spec:
  ipam:
    resourcePools: {}
