hive start

k8s/add ippool.yaml node.yaml claim.yaml
driver/ipam/restore-finished

# Prepare claim
# Just like in a real cluster, this is retried until successful. An initial failure
# is not an error: as an example, when referencing a CiliumResourceIPPool, the address
# allocation fails until the operator assigns a CIDR to the node.
* driver/prepare-resource-claims default/test-claim

# The status of the resource claim should be updated with the allocated addresses from the IPAM pool.
driver/check-claim-addresses default/test-claim test-device test-ip-pool

# Check CiliumNode resource pools after allocation
k8s/get cilium.io.v2.ciliumnodes test-local-node -o node.actual.yaml
* cmp node.actual.yaml node.expected.yaml

# Unprepare the claim
driver/unprepare-resource-claims default/test-claim

# Check CiliumNode resource pools after release
# `resourcePools: {}` will be an empty slice not `nil`.
k8s/get cilium.io.v2.ciliumnodes test-local-node -o node-released.actual.yaml
* cmp node-released.actual.yaml node-released.expected.yaml

hive stop

-- ippool.yaml --
apiVersion: cilium.io/v2alpha1
kind: CiliumResourceIPPool
metadata:
  name: test-ip-pool
spec:
  ipv4:
    cidrs:
    - 10.10.0.0/16
    maskSize: 24
  ipv6:
    cidrs:
    - fd00:200:1::/48
    maskSize: 64

-- node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  name: test-local-node
  labels:
    kubernetes.io/hostname: test-local-node
spec: {}

-- claim.yaml --
apiVersion: resource.k8s.io/v1
kind: ResourceClaim
metadata:
  name: test-claim
  namespace: default
  uid: ba3c7922-9a56-44eb-a96f-84ee8b74dd23
spec: {}
status:
  allocation:
    devices:
      config:
      - source: FromClaim
        requests:
        - test-request
        opaque:
          driver: test.cilium.k8s.io
          parameters:
            ipPool: test-ip-pool
      results:
      - device: test-device
        driver: test.cilium.k8s.io
        pool: test-device-pool
        request: test-request
  reservedFor:
  - resource: pods
    name: test-pod
    uid: bec9dd67-13f9-4d4b-a3c1-76fc3e485e68
-- node.expected.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  labels:
    kubernetes.io/hostname: test-local-node
  name: test-local-node
spec:
  ipam:
    resourcePools:
      allocated:
      - cidrs:
        - fd00:200:1::/64
        pool: test-ip-pool
      requested:
      - needed:
          ipv6-addrs: 1
        pool: test-ip-pool
-- node-released.expected.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  labels:
    kubernetes.io/hostname: test-local-node
  name: test-local-node
spec:
  ipam:
    resourcePools: {}
