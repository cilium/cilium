-- expected.yaml --
name: config1
spec:
    ipv4:
        - cidr: 10.0.0.0/16
          prefixLength: 24
          routes:
            - destination: 192.168.1.0/24
              gateway: 10.0.0.1
            - destination: 172.16.0.0/12
        - cidr: 10.1.0.0/16
    ipv6:
        - cidr: fd00::/48
          prefixLength: 64
          routes:
            - destination: fd01::/64
              gateway: fd00::1
            - destination: fd02::/64
        - cidr: fd10::/48
updatedAt: 2000-01-01T10:30:00Z
-- config.yaml --
apiVersion: cilium.io/v2alpha1
kind: CiliumResourceNetworkConfig
metadata:
  name: config1
spec:
  ipv4:
    - cidr: 10.0.0.0/16
      prefixLength: 24
      routes:
        - destination: 192.168.1.0/24
          gateway: 10.0.0.1
        - destination: 172.16.0.0/12
    - cidr: 10.1.0.0/16
  ipv6:
    - cidr: fd00::/48
      prefixLength: 64
      routes:
        - destination: fd01::/64
          gateway: fd00::1
        - destination: fd02::/64
    - cidr: fd10::/48
