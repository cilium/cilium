#
# Validate reflection and indexing of Table[LocalResourceNetworkConfig]
#

# Start and wait for reflector to sync up (List & Watch). This is needed
# as the fake k8s client is dumb and would miss events between the List
# and Watch calls.
hive start
db/initialized

# Start state: empty table
db/empty k8s-cilium-resource-netconfigs

# Add config object
k8s/add config.yaml

# Validate table contents and reflector health
db/cmp k8s-cilium-resource-netconfigs configs.table
db/cmp --grep=reflector-k8s-cilium-resource-netconfigs health health.table

# Verify JSON & YAML exports
db/show --format=json --out=actual.json k8s-cilium-resource-netconfigs
cmp expected.json actual.json

db/show --format=yaml --out=actual.yaml k8s-cilium-resource-netconfigs
cmp expected.yaml actual.yaml

# Verify name index
db/get --index=name --columns=Name --out=actual.table k8s-cilium-resource-netconfigs config1
cmp configs_name.table actual.table

# Remove config object
k8s/delete config.yaml

# Table should be empty
* db/empty k8s-cilium-resource-netconfigs

-- health.table --
Component                                                                                       Level   Message
job-k8s-reflector-k8s-cilium-resource-netconfigs-cilium-resource-network-config-k8s-reflector   OK      1 upserted, 0 deleted, 1 total objects
-- configs.table --
Name      IPv4                                                                                           IPv6                                                                             Age
config1   10.0.0.0/16 PrefixLength=24 Routes=[192.168.1.0/24 via 10.0.0.1, 172.16.0.0/12], 10.1.0.0/16   fd00::/48 PrefixLength=64 Routes=[fd01::/64 via fd00::1, fd02::/64], fd10::/48   60s
-- configs_name.table --
Name
config1
