@@ -18,11 +18,25 @@ package prom
 
 import (
 	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
 	"time"
 
 	clientset "k8s.io/client-go/kubernetes"
 )
 
+// prometheusHostOverrideEnv, if set to a "host:port", queries Prometheus with a
+// direct HTTP request to that address instead of going through the apiserver's
+// service-proxy subresource below. Some managed control planes (e.g. EKS) refuse
+// to proxy to pod IPs outside the cluster's VPC CIDR, which breaks ProxyGet for
+// overlay CNIs. Point this at a `kubectl port-forward`'d local port to work
+// around that: port-forward is unaffected, since it's routed through the pod's
+// node (kubelet) rather than dialed directly by the apiserver.
+const prometheusHostOverrideEnv = "PROMETHEUS_HOST_OVERRIDE"
+
 // inClusterPrometheusClient talks to the Prometheus instance deployed in the test cluster.
 type inClusterPrometheusClient struct {
 	client clientset.Interface
@@ -33,12 +47,39 @@ func (icpc *inClusterPrometheusClient) Query(query string, queryTime time.Time)
 		"query": query,
 		"time":  queryTime.Format(time.RFC3339),
 	}
+
+	if host := os.Getenv(prometheusHostOverrideEnv); host != "" {
+		return queryOverHTTP(host, params)
+	}
+
 	return icpc.client.CoreV1().
 		Services("monitoring").
 		ProxyGet("http", "prometheus-k8s", "9090", "api/v1/query", params).
 		DoRaw(context.TODO())
 }
 
+func queryOverHTTP(host string, params map[string]string) ([]byte, error) {
+	q := url.Values{}
+	for k, v := range params {
+		q.Set(k, v)
+	}
+
+	resp, err := http.Get(fmt.Sprintf("http://%s/api/v1/query?%s", host, q.Encode()))
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, err
+	}
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("prometheus query failed: %s: %s", resp.Status, string(body))
+	}
+	return body, nil
+}
+
 func NewInClusterPrometheusClient(c clientset.Interface) Client {
 	return &inClusterPrometheusClient{client: c}
 }
