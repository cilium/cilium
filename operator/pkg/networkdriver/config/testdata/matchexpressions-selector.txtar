hive start

# Add three nodes with different roles

k8s/add kind-worker-node.yaml
k8s/add kind-worker-2-node.yaml
k8s/add kind-control-plane-node.yaml

# Add a cluster configuration using matchExpressions (In + NotIn + Exists)
# instead of matchLabels, matching only nodes with role in {worker, gpu-worker}
# and role != excluded, and that have the "gpu" label present.

k8s/add driver-cluster-config.yaml

# Only kind-worker-2 satisfies all matchExpressions (role in [worker, gpu-worker],
# role NotIn [excluded], and label "gpu" Exists).

* db/cmp netdriver-node-config node-config.table

* k8s/get cilium.io.v2alpha1.ciliumnetworkdrivernodeconfigs kind-worker-2 -o kind-worker-2-config-actual.yaml
* cmp kind-worker-2-config-expected.yaml kind-worker-2-config-actual.yaml

hive stop

# ----

-- kind-worker-node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  labels:
    kubernetes.io/hostname: kind-worker
    role: worker
  name: kind-worker
spec: {}
-- kind-worker-2-node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  labels:
    kubernetes.io/hostname: kind-worker-2
    role: gpu-worker
    gpu: "true"
  name: kind-worker-2
spec: {}
-- kind-control-plane-node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  labels:
    kubernetes.io/hostname: kind-control-plane
    role: excluded
    gpu: "true"
  name: kind-control-plane
spec: {}
-- driver-cluster-config.yaml --
apiVersion: cilium.io/v2alpha1
kind: CiliumNetworkDriverClusterConfig
metadata:
  name: driver-cluster-config
spec:
  nodeSelector:
    matchExpressions:
      - key: role
        operator: In
        values:
          - worker
          - gpu-worker
      - key: role
        operator: NotIn
        values:
          - excluded
      - key: gpu
        operator: Exists
  spec:
    draRegistrationRetryInterval: 1
    draRegistrationTimeout: 600
    driverName: "dummy.cilium.k8s.io"
    pools:
      - name: "dummy-pool"
        filter:
          deviceManagers:
            - "dummy"
    deviceManagerConfigs:
      dummy:
        enabled: true

-- node-config.table --
