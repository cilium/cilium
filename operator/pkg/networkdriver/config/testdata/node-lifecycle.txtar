hive start

# Add a cluster configuration before any node exists

k8s/add driver-cluster-config.yaml

# No nodes yet — table must be empty

* db/empty netdriver-node-config

# Node joins the cluster and is matched by the cluster config

k8s/add kind-worker-node.yaml

* db/cmp netdriver-node-config node-config.table

* k8s/get cilium.io.v2alpha1.ciliumnetworkdrivernodeconfigs kind-worker -o kind-worker-config-actual.yaml
* cmp kind-worker-config-expected.yaml kind-worker-config-actual.yaml

# Node is deleted from the cluster — its NodeConfig must be removed

k8s/delete kind-worker-node.yaml

* db/empty netdriver-node-config

# Node re-joins the cluster — the NodeConfig must be re-created

k8s/add kind-worker-node.yaml

* db/cmp netdriver-node-config node-config.table

* k8s/get cilium.io.v2alpha1.ciliumnetworkdrivernodeconfigs kind-worker -o kind-worker-config-actual-2.yaml
* cmp kind-worker-config-expected.yaml kind-worker-config-actual-2.yaml

hive stop

# ----

-- kind-worker-node.yaml --
apiVersion: cilium.io/v2
kind: CiliumNode
metadata:
  labels:
    kubernetes.io/hostname: kind-worker
  name: kind-worker
spec: {}
-- driver-cluster-config.yaml --
apiVersion: cilium.io/v2alpha1
kind: CiliumNetworkDriverClusterConfig
metadata:
  name: driver-cluster-config
spec:
  nodeSelector:
    matchLabels:
      kubernetes.io/hostname: kind-worker
  spec:
    draRegistrationRetryInterval: 1
    draRegistrationTimeout: 600
    driverName: "dummy.cilium.k8s.io"
    pools:
      - name: "dummy-pool"
        filter:
          deviceManagers:
            - "dummy"
    deviceManagerConfigs:
      dummy:
        enabled: true

-- node-config.table --
Node             ClusterConfig          Config                                                                                                                                                                                                                                           Status  Error
kind-worker      driver-cluster-config  {"draRegistrationRetryInterval":1,"draRegistrationTimeout":600,"driverName":"dummy.cilium.k8s.io","pools":[{"name":"dummy-pool","filter":{"deviceManagers":["dummy"]}}],"deviceManagerConfigs":{"dummy":{"enabled":true}}}                       Done    
-- kind-worker-config-expected.yaml --
apiVersion: cilium.io/v2alpha1
kind: CiliumNetworkDriverNodeConfig
metadata:
  name: kind-worker
spec:
  deviceManagerConfigs:
    dummy:
      enabled: true
  draRegistrationRetryInterval: 1
  draRegistrationTimeout: 600
  driverName: dummy.cilium.k8s.io
  pools:
  - filter:
      deviceManagers:
      - dummy
    name: dummy-pool
